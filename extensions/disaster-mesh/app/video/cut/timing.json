 "pieces": [
  {
   "seg": "01",
   "k": 0,
   "t0": 0.4,
   "t1": 5.897,
   "vo": "Disaster Mesh. When the internet is gone, the phones of a Tremor Witness site keep working together."
  },
  {
   "seg": "02",
   "k": 0,
   "t0": 6.9,
   "t1": 14.192,
   "vo": "Three phones, each registered on E N S at one site. Wi-Fi and mobile data are off. They find each other over Bluetooth."
  },
  {
   "seg": "03",
   "k": 0,
   "t0": 17.8,
   "t1": 25.824,
   "vo": "For this demo, each phone sends a test shaking signal. Real detection needs strong shaking, about ninety-six millimetres per second."
  },
  {
   "seg": "04",
   "k": 0,
   "t0": 27.8,
   "t1": 36.643,
   "vo": "Every phone runs the same quorum rule as the dashboard: three registered phones within two seconds. Disaster confirmed, on every phone, with no server."
  },
  {
   "seg": "05",
   "k": 0,
   "t0": 37.55,
   "t1": 45.62,
   "vo": "Phone B needs help, and adds a note. Phone A is safe. Every message is signed by the phone's own key, and only registered phones count."
  },
  {
   "seg": "06",
   "k": 0,
   "t0": 50.55,
   "t1": 55.528,
   "vo": "Each phone lists who has not been heard from, straight from the registry. No G P S."
  },
  {
   "seg": "07",
   "k": 0,
   "t0": 58.05,
   "t1": 63.904,
   "vo": "Phone A gets internet back. It writes its own check-in to Arkiv. The test signals never leave the phone."
  },
  {
   "seg": "08",
   "k": 0,
   "t0": 68.05,
   "t1": 73.56,
   "vo": "Read back with the Tremor Witness code: the creator is phone A, and it points to the confirmed alert."
  },
  {
   "seg": "99",
   "k": 0,
   "t0": 78.25,
   "t1": 84.36,
   "vo": "Same phones, same keys, same quorum rule. It keeps working when the servers and the internet are gone."
  }
 ],
